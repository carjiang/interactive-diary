{ "entry_id": "diary_20260320_001", "entry_timestamp": "2026-03-20T00:00:00Z", "raw_text": "This morning, my cat Mochi sat by the window and watched the rain. I walked to the café, bought espresso, and checked the notes. At 10:30, Maya texted me that the project timeline had shifted. The barista, Hassan, smiled at me without saying much. I realized later that Dr. Chen had scheduled the review for Friday instead of Thursday. Maya noticed the calendar mistake before I saw it. I mailed the apology email to Dr. Chen at noon. Then the cat knocked over the water bottle in the hallway. Everything felt unusually quiet. Tonight I kept thinking about how the miscommunication started, and I promised myself to double-check.", "nersamples": [ { "tokens": [ "This", "morning,", "my", "cat", "Mochi", "sat", "by", "the", "window", "and", "watched", "the", "rain." ], "bio_tags": [ "B-TEMPORAL", "I-TEMPORAL", "B-PARTICIPANT", "I-PARTICIPANT", "I-PARTICIPANT", "O", "O", "O", "O", "O", "B-PERCEPTION", "O", "O" ] }, { "tokens": [ "I", "walked", "to", "the", "café,", "bought", "espresso,", "and", "checked", "the", "notes." ], "bio_tags": [ "B-PARTICIPANT", "B-ACTION", "O", "O", "O", "B-ACTION", "O", "O", "B-ACTION", "B-CONTENT", "I-CONTENT" ] }, { "tokens": [ "At", "10:30,", "Maya", "texted", "me", "that", "the", "project", "timeline", "had", "shifted." ], "bio_tags": [ "B-TEMPORAL", "I-TEMPORAL", "B-PARTICIPANT", "B-ACTION", "B-PARTICIPANT", "B-CONTENT", "I-CONTENT", "I-CONTENT", "I-CONTENT", "I-CONTENT", "I-CONTENT" ] }, { "tokens": [ "The", "barista,", "Hassan,", "smiled", "at", "me", "without", "saying", "much." ], "bio_tags": [ "O", "O", "B-PARTICIPANT", "B-ACTION", "O", "B-PARTICIPANT", "O", "B-ACTION", "O" ] }, { "tokens": [ "I", "realized", "later", "that", "Dr.", "Chen", "had", "scheduled", "the", "review", "for", "Friday", "instead", "of", "Thursday." ], "bio_tags": [ "B-PARTICIPANT", "B-BELIEF_CUE", "B-TEMPORAL", "O", "B-PARTICIPANT", "I-PARTICIPANT", "O", "B-ACTION", "B-CONTEN